### create team 
POST http://localhost:3000/api/teams
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsImlhdCI6MTc3ODU5NzIxMSwiZXhwIjoxNzc4NTk3ODExfQ.01GHxqsC_wsQrpycEe7VPvbzt0Nbt3R_cA6XcU9wp9M
Content-Type: application/json

{
    "teamName": "test",
    "description": "this team is to test the code"
}

### get all the users team
GET http://localhost:3000/api/teams
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VySWQiOjEsImlhdCI6MTc3ODU5NzQwMCwiZXhwIjoxNzc4NTk4MDAwfQ.LdxQ3Y7HOwwaSQMIK4lfdRmYEzlTX-unwBksCzLjVBM

